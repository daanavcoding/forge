{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/hook.mjs\" --codex-only",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\hook.mjs\" --codex-only",
            "statusMessage": "Loading Forge"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/scripts/session-end.mjs\" --codex-only",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\session-end.mjs\" --codex-only",
            "statusMessage": "Saving Forge telemetry"
          }
        ]
      }
    ]
  }
}
